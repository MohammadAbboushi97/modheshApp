# Copy to .env and adjust per deployment.
APP_NAME=offers
PORT=8080
DB_FILE=offers.sqlite
# Local image folder, used only when IMAGE_BASE_URL is empty (development).
IMAGE_STORAGE_PATH=static/images

# Public base URL of the image storage (S3 bucket, CloudFront, MinIO...).
# Every image key below and in the database is loaded from <IMAGE_BASE_URL>/<key>.
# Example: https://modhesh-images.s3.eu-central-1.amazonaws.com
IMAGE_BASE_URL=

# Rotating banner on home and sector pages (comma-separated image keys).
HOME_SLIDES=home-banner.png,app-logo.png
# Official sponsor strip at the top of the app (hidden when SPONSOR_NAME is empty).
SPONSOR_NAME=
SPONSOR_LOGO=
SPONSOR_URL=
# Sector tile images as <storeType>:<image key>.
SECTOR_IMAGES=HoReCa:home-banner.png,Retail:app-logo.png,Wholesale:home-banner.png
# Timed ad popup on the home screen (hidden when AD_POPUP_IMAGE is empty).
AD_POPUP_IMAGE=home-banner.png
AD_POPUP_SECONDS=4

# Footer and contact details.
SOCIAL_FACEBOOK_URL=https://www.facebook.com
SOCIAL_INSTAGRAM_URL=https://www.instagram.com
SOCIAL_WHATSAPP_URL=https://wa.me/962795041122
SUPPORT_EMAIL=
SERVICE_NUMBERS=065520002,0795041122,0775041122

# Admin page (http://<server>/admin). The page is disabled until both are set.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Long random string used to sign admin sessions (keeps them valid across restarts).
ADMIN_TOKEN_SECRET=

# Image uploads from the admin page go to S3 when S3_BUCKET is set,
# otherwise to IMAGE_STORAGE_PATH. Credentials use the standard AWS
# variables (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY) or an instance role.
# If IMAGE_BASE_URL is empty, images are read from the bucket's public URL.
S3_BUCKET=
S3_REGION=
S3_PREFIX=uploads/
# Only for S3-compatible services such as MinIO.
S3_ENDPOINT=
